{
  "name": "@barrel-kit/sdk-electron",
  "version": "0.0.1",
  "description": "Barrel's release-intelligence SDK for Electron apps.",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ipc": {
      "types": "./dist/ipc.d.ts",
      "default": "./dist/ipc.js"
    },
    "./preload": {
      "require": {
        "types": "./dist/preload.d.cts",
        "default": "./dist/preload.cjs"
      },
      "import": {
        "types": "./dist/preload.d.ts",
        "default": "./dist/preload.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test-service": "node --import tsx --import ./src/testService/registerElectronMock.ts src/testService/server.ts",
    "lint": "oxlint --disable-nested-config --max-warnings=0 .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@barrel-kit/sdk-conformance-harness": "github:barrelsystems/sdk-conformance-harness#dist",
    "@effect/platform-node": "^4.1.4",
    "@types/node": "^24.0.0",
    "effect": "^4.1.4",
    "electron": "^42.11.16",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.11",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsdown": "^0.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "electron": ">=30.0.0",
    "electron-squirrel-startup": ">=1.0.0",
    "electron-updater": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "electron-squirrel-startup": {
      "optional": true
    },
    "electron-updater": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "rolldown"
    ]
  }
}
