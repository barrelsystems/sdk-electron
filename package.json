{
  "name": "@barrel-kit/sdk-electron",
  "version": "0.0.1",
  "description": "Barrel's release-intelligence SDK for Electron apps.",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json && tsc --noEmit -p examples/electron-builder-app/tsconfig.json && tsc --noEmit -p examples/electron-forge-app/tsconfig.json",
    "test": "vitest run",
    "test-service": "node --import tsx --import ./src/testService/registerElectronMock.ts src/testService/main.ts",
    "lint": "oxlint --disable-nested-config --max-warnings=0 .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "size": "size-limit",
    "unused": "knip",
    "check:examples": "tsx scripts/checkExamples.ts",
    "install:examples": "pnpm --dir examples/electron-builder-app install --frozen-lockfile && pnpm --dir examples/electron-forge-app install --frozen-lockfile"
  },
  "devDependencies": {
    "@barrel-kit/sdk-conformance-harness": "github:barrelsystems/sdk-conformance-harness#dist",
    "@effect/platform-node": "^4.1.4",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^24.0.0",
    "effect": "^4.1.4",
    "electron": "^42.11.16",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.11",
    "knip": "^6.48.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "electron": ">=30.0.0",
    "electron-squirrel-startup": ">=1.0.0",
    "electron-updater": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "electron-squirrel-startup": {
      "optional": true
    },
    "electron-updater": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "import { init, ... } from '@barrel-kit/sdk-electron'",
      "path": [
        "dist/index.js",
        "dist/chunks/*.js"
      ],
      "limit": "15 KB"
    }
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "rolldown"
    ]
  }
}
